{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/font/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/es",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/es",
      "permanent": true
    },
    {
      "source": "/alojamiento",
      "destination": "/es/alojamiento",
      "permanent": true
    },
    {
      "source": "/cal-masses",
      "destination": "/es/cal-masses",
      "permanent": true
    },
    {
      "source": "/sisu",
      "destination": "/es/sisu",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/es/contacto",
      "permanent": true
    },
    {
      "source": "/contacte",
      "destination": "/ca/contacte",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/reservar",
      "destination": "/es/reservar",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/en/book",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon-32.png",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/apple-touch-icon.png",
      "permanent": true
    },
    {
      "source": "/es/alojamiento-cerca-manresa",
      "destination": "/es/alojamiento-rural-cerca-manresa",
      "permanent": true
    },
    {
      "source": "/es/escapada-para-dos",
      "destination": "/es/alojamiento-rural-para-dos-bages",
      "permanent": true
    },
    {
      "source": "/ca/escapada-per-a-dos",
      "destination": "/ca/allotjament-rural-per-a-dos-bages",
      "permanent": true
    },
    {
      "source": "/en/getaway-for-two",
      "destination": "/en/rural-accommodation-for-two-bages",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|images/|fotos|fotosTargetes|fotosVino|logo|font|robots.txt|sitemap.xml|favicon|apple-touch-icon).*)",
      "destination": "/index.html"
    }
  ]
}
