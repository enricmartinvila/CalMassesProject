{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|images/|fotos|fotosTargetes|fotosVino|logo|font|robots.txt|sitemap.xml|favicon|apple-touch-icon).*)",
      "destination": "/index.html"
    }
  ]
}
